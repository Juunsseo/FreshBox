# Database. SQLite is enough for the hackathon; swap this URL for PostgreSQL later.
DATABASE_URL=sqlite:///./freshbox.db

# Browser frontend origins, comma-separated.
CORS_ORIGINS=http://localhost:43123

# Seeds one baseline sensor reading on first run; food starts empty.
# Set false once you only want real containers/readings.
DEMO_MODE=true

# BLE is off by default so the API can run on machines without Bluetooth.
ENABLE_BLE=false
BLE_DEVICE_NAME=FreshPod
BLE_POD_ID=freshbox-01
BLE_SENSOR_CHARACTERISTIC_UUID=e6f59d11-8230-4a5c-b22f-c062b1d329e3

# Optional recipe generation.
XAI_API_KEY=
XAI_MODEL=grok-4.6
